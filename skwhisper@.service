[Unit]
Description=SKWhisper — %i agent subconscious memory layer
After=network.target

[Service]
Type=simple
# %i = agent name (e.g. jarvis, aster, lumina)
# %h = user home directory (resolved by systemd)
ExecStart=%h/.local/bin/skwhisper daemon
Environment=SKCAPSTONE_AGENT=%i
Environment=HOME=%h
Restart=on-failure
RestartSec=30

# Log to journald (bounded + rotated). The old append:daemon.log was UNBOUNDED and
# grew past 300M per agent, helping push a node to 99% disk (2026-08-15). View with:
#   journalctl --user -u skwhisper@<agent> -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
